@using Inventa.Web.Models.Precios
@using Inventa.Web.Services.Precios
@inject PreciosApiService Api
@* S93.1 (K5): historial de vigencias y ofertas de una variante, con su estado calculado (panel lateral). *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Historial de precios</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Nombre</MudText>
    </TitleContent>
    <DialogContent>
        @if (_h is null && _error is null) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
        else if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Precio oficial</MudText>
            <MudSimpleTable Dense="true" Bordered="true" Class="mb-4" data-testid="historial-precios">
                <thead><tr><th>Desde</th><th>Valor</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var p in _h!.Precios)
                    {
                        <tr><td>@FormatoCl.Fecha(p.Desde)</td><td>@FormatoCl.Moneda(p.Valor)</td><td><MudChip T="string" Size="Size.Small" Color="@ColorEstado(p.Estado)">@PreciosUi.TextoEstado(p.Estado)</MudChip></td></tr>
                    }
                    @if (_h.Precios.Count == 0) { <tr><td colspan="3">Sin precios.</td></tr> }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.subtitle2" Class="mb-1">Ofertas</MudText>
            <MudSimpleTable Dense="true" Bordered="true" data-testid="historial-ofertas">
                <thead><tr><th>Periodo</th><th>Oferta</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var o in _h!.Ofertas)
                    {
                        <tr>
                            <td>@FormatoCl.Fecha(o.Desde) – @(o.Hasta is null ? "sin término" : FormatoCl.Fecha(o.Hasta))</td>
                            <td>@FormatoCl.Moneda(o.Precio)@(o.ValorReferencia is decimal r ? $" (ref. {FormatoCl.Moneda(r)})" : "")</td>
                            <td>
                                <MudChip T="string" Size="Size.Small" Color="@ColorEstado(o.Estado)">@PreciosUi.TextoEstado(o.Estado)</MudChip>
                                @if (o.Motivo is not null) { <MudText Typo="Typo.caption" Color="Color.Warning">@PreciosUi.TextoMotivo(o.Motivo)</MudText> }
                            </td>
                        </tr>
                    }
                    @if (_h!.Ofertas.Count == 0) { <tr><td colspan="3">Sin ofertas.</td></tr> }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()">Cerrar</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public long IdPresProd { get; set; }
    [Parameter] public string Nombre { get; set; } = "";
    private HistorialPreciosDto? _h;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _h = await Api.GetHistorialAsync(IdPresProd, CancellationToken.None); if (_h is null) _error = "La variante ya no existe."; }
        catch (Inventa.Web.Models.Api.ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = "No se pudo contactar al servidor."; }
    }

    private static Color ColorEstado(string e) => e switch
    {
        "Vigente" or "Efectiva" => Color.Success,
        "Programado" or "Programada" => Color.Info,
        "SinEfecto" => Color.Warning,
        "Anulado" or "Terminada" => Color.Default,
        _ => Color.Default
    };
}
