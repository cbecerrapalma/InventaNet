@page "/compras/ordenes"
@attribute [Authorize]
@inject Inventa.Web.Services.Compras.ComprasApiService Svc
@inject Inventa.Web.Services.Auth.PermissionService PermsService
@inject Inventa.Web.Services.Tenant.TenantContextService TenantCtx
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@implements IDisposable

<PageHeader Title="Órdenes de Compra" Description="Órdenes de compra a proveedores, de la más reciente a la más antigua." Icon="@Icons.Material.Filled.ShoppingBag">
    <Actions>@if(_canCrear){<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate" aria-label="Nueva orden">Nueva orden</MudButton>}</Actions>
</PageHeader>

@if (!_checked){<LoadingState />}
else if (!_allowed){<Forbidden />}
else if (_loading){<LoadingState Message="Cargando órdenes..." />}
else if (_error is not null){<ErrorState Title="@_error.Title" Detail="@_error.Detail" CorrelationId="@_error.CorrelationId" OnRetry="Reload" />}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)" data-testid="ordenes-filtros">
        <MudGrid Spacing="2">
            <MudItem xs="10" sm="6"><MudTextField @bind-Value="_search" Label="Buscar por número, proveedor u observación" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="OnSearchDebounced" Clearable="true" aria-label="Buscar compras" /></MudItem>
            <MudItem xs="2" sm="6" Class="d-flex justify-end align-center">
                <MudTooltip Text="Actualizar"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="Actualizar" /></MudTooltip>
                <div class="d-none d-sm-block ml-2" data-testid="ordenes-por-pagina"><MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Label="Por página" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:110px"><MudSelectItem Value="20">20</MudSelectItem><MudSelectItem Value="50">50</MudSelectItem><MudSelectItem Value="100">100</MudSelectItem></MudSelect></div>
            </MudItem>
        </MudGrid>
    </MudPaper>
    @if (_items.Count==0)
    {
        <EmptyState Title="Sin órdenes" Description="@(string.IsNullOrWhiteSpace(_search)?"Aún no hay órdenes de compra.":"No hay resultados para el filtro.")" Icon="@Icons.Material.Filled.ShoppingBag">
            <Action>@if(_canCrear){<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">Crear orden</MudButton>}</Action>
        </EmptyState>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Mostrando 0 de @FormatoCl.Miles(_totalCount)</MudText>
    }
    else
    {
        <MudTable Items="@_items" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0" Class="mb-2 inv-tabla-compacta inv-tabla-tarjeta" data-testid="tabla-ordenes">
            <HeaderContent><MudTh>N° orden</MudTh><MudTh>Proveedor</MudTh><MudTh>Fecha</MudTh><MudTh>Total</MudTh><MudTh>Estado</MudTh><MudTh Style="width:120px">Acciones</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="N° orden" Class="inv-celda-titulo"><MudLink Href="@($"/compras/ordenes/{context.IdOrdenCompra}")"><b>@context.NumOrden</b></MudLink></MudTd>
                <MudTd DataLabel="Proveedor">@context.ProveedorNombre</MudTd>
                <MudTd DataLabel="Fecha">@FormatoCl.Fecha(context.FecOrden)</MudTd>
                <MudTd DataLabel="Total">@FormatoCl.Moneda(context.Total)</MudTd>
                <MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Color="@EstadoColor(context.Estado)" Class="ma-0">@EstadoNombre(context.Estado)</MudChip></MudTd>
                <MudTd DataLabel="Acciones" HideSmall="true"><MudTooltip Text="Ver"><MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/compras/ordenes/{context.IdOrdenCompra}")" aria-label="Ver orden" /></MudTooltip></MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="paginacion-texto">Mostrando @FormatoCl.Miles(_pageStart+1)–@FormatoCl.Miles(_pageEnd) de @FormatoCl.Miles(_totalCount)</MudText>
            <MudPagination Count="@_totalPages" Selected="_page" SelectedChanged="OnPageChanged" Color="Color.Primary" BoundaryCount="1" MiddleCount="1" aria-label="Paginación compras" />
        </MudStack>
    }
}

@code {
    private bool _checked; private bool _allowed; private bool _canCrear; private bool _loading=true; private Inventa.Web.Models.Api.ApiError? _error;
    private List<Inventa.Web.Models.Compras.OrdenCompraDto> _items=[];
    private string _search=""; private int _page=1; private int _pageSize=20; private int _totalCount; private int _totalPages=1; private int _pageStart; private int _pageEnd;
    private CancellationTokenSource? _cts; private int _loadGen;
    protected override async Task OnInitializedAsync(){ _allowed=await PermsService.HasPermissionAsync("INVENTA_COMPRAS_ORDENES_VER"); _canCrear=await PermsService.HasPermissionAsync("INVENTA_COMPRAS_ORDENES_CREAR"); _checked=true; if(!_allowed) return; TenantCtx.OnTenantChanged+=OnTenantChanged; await LoadAsync(); }
    private void OnTenantChanged(int? localId, int? passPlatId){ _ = OnTenantChangedAsync(localId); }
    private async Task OnTenantChangedAsync(int? localId){ _cts?.Cancel(); _loadGen++; _items.Clear(); _totalCount=0; _totalPages=1; _page=1; await InvokeAsync(async()=>{ _loading=true; StateHasChanged(); await LoadAsync(); StateHasChanged();}); }
    private async Task LoadAsync(){ _cts?.Cancel(); _cts=new CancellationTokenSource(); var ct=_cts.Token; var gen=++_loadGen; _loading=true; _error=null; StateHasChanged(); try{ var paged=await Svc.GetOrdenesPagedAsync(_search,_page,_pageSize,ct); if(ct.IsCancellationRequested||gen!=_loadGen) return; if(paged is null){ _items=[]; _totalCount=0; _totalPages=1;} else { _items=paged.Items.ToList(); _totalCount=paged.TotalCount; _totalPages=Math.Max(1,paged.TotalPages);} if(_page> _totalPages){ _page=_totalPages; await LoadAsync(); return;} _pageStart=_totalCount==0?0:(_page-1)*_pageSize; _pageEnd=Math.Min(_pageStart+_items.Count,_totalCount);} catch(Inventa.Web.Models.Api.ApiException ex){ if(gen!=_loadGen) return; _error=ex.ToApiError(); if(ex.StatusCode==401) Snackbar.Add("Sesión expirada", Severity.Warning);} catch(OperationCanceledException){} catch(Exception ex){ if(gen!=_loadGen) return; _error=new(){StatusCode=0, Title="Error", Detail=ex.Message};} finally{ if(gen==_loadGen){ _loading=false; StateHasChanged();}} }
    private async Task Reload(){ _page=1; await LoadAsync(); }
    private static string EstadoNombre(byte e)=> e switch{1=>"Pendiente",2=>"Aprobada",3=>"Recibida",4=>"Cancelada", _=>$"Estado {e}"};
    private static Color EstadoColor(byte e)=> e switch{1=>Color.Warning,2=>Color.Info,3=>Color.Success,4=>Color.Error,_=>Color.Default};
    private async Task OnSearchDebounced(string v){ _search=v??""; _page=1; await LoadAsync(); }
    private async Task OnPageChanged(int p){ _page=p; await LoadAsync(); }
    private async Task OnPageSizeChanged(int s){ _pageSize=s; _page=1; await LoadAsync(); }
    private async Task OpenCreate(){ var dlg=await Dialogs.ShowAsync<Inventa.Web.Shared.Purchase.PurchaseOrderFormDialog>("Nueva orden", new DialogOptions{ MaxWidth=MaxWidth.Medium, FullWidth=true }); var r=await dlg.Result; if(r is not null && !r.Canceled) await LoadAsync(); }
    public void Dispose(){ TenantCtx.OnTenantChanged-=OnTenantChanged; _cts?.Cancel(); _cts?.Dispose(); }
}
