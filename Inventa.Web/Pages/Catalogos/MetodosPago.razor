@page "/catalogos/metodos-pago"
@attribute [Authorize]
@inject Inventa.Web.Services.Catalogos.CatalogosApiService Svc
@inject Inventa.Web.Services.Auth.PermissionService Perms
<PageHeader Title="Métodos de Pago" Description="Métodos de pago comunes a todos los tenants." Icon="@Icons.Material.Filled.Payment" />

@if(!_checked){<LoadingState />}
else if(!_allowed){<Forbidden />}
else if(_loading){<LoadingState Message="Cargando métodos de pago..." />}
else if(_error is not null){<ErrorState Title="@_error.Title" Detail="@_error.Detail" CorrelationId="@_error.CorrelationId" OnRetry="Load" />}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_search" Label="Buscar..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="250" OnDebounceIntervalElapsed="ApplyFilter" Clearable="true" aria-label="Buscar métodos de pago" /></MudItem>
            <MudItem xs="12" md="6" Class="d-flex justify-end align-center"><MudTooltip Text="Actualizar"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" aria-label="Actualizar" /></MudTooltip><MudChip T="string" Color="Color.Info" Size="Size.Small" Class="ml-2">Global · Solo lectura</MudChip></MudItem>
        </MudGrid>
    </MudPaper>
    @if(_filtered.Count==0){<EmptyState Title="Sin métodos de pago" Description="@(_all.Count==0?"No existen métodos de pago.":"No hay resultados.")" Icon="@Icons.Material.Filled.Payment" />}
    else{
        <MudTable Items="@_paged" Dense="true" Hover="true" Elevation="0" Bordered="true" Class="mb-2 inv-tabla-compacta inv-tabla-lista" data-testid="tabla-metodos-pago">
            <HeaderContent><MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh>Estado</MudTh></HeaderContent>
            <RowTemplate><MudTd DataLabel="Código"><b>@context.Codigo</b></MudTd><MudTd DataLabel="Nombre" Class="inv-celda-titulo">@context.Nombre</MudTd><MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Color="@(context.Activo?Color.Success:Color.Default)">@(context.Activo?"Activo":"Inactivo")</MudChip></MudTd></RowTemplate>
        </MudTable>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap"><MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="paginacion-texto">Mostrando @FormatoCl.Miles(_start+1)–@FormatoCl.Miles(_end) de @FormatoCl.Miles(_filtered.Count)</MudText><MudPagination Count="@_pageCount" Selected="_page" SelectedChanged="OnPageChanged" Color="Color.Primary" BoundaryCount="1" MiddleCount="1" aria-label="Paginación métodos de pago" /></MudStack>
    }
}
@code{
    private bool _checked,_allowed; private bool _loading=true; private Inventa.Web.Models.Api.ApiError? _error;
    private List<Inventa.Web.Models.Catalogos.MetodoPagoDto> _all=[]; private List<Inventa.Web.Models.Catalogos.MetodoPagoDto> _filtered=[]; private List<Inventa.Web.Models.Catalogos.MetodoPagoDto> _paged=[];
    private string _search=""; private int _page=1,_pageSize=20,_pageCount=1,_start,_end; private CancellationTokenSource? _cts;
    protected override async Task OnInitializedAsync(){ _allowed=await Perms.HasPermissionAsync("INVENTA_CATALOGOS_METODOS_PAGO_VER"); _checked=true; if(!_allowed) return; await Load(); }
    private async Task Load(){
        _cts?.Cancel(); _cts=new();
        _loading=true;_error=null;StateHasChanged();
        try{ _all = await Svc.GetMetodosPagoAsync(_cts.Token) ?? []; ApplyFilter();}
        catch(Inventa.Web.Models.Api.ApiException ex){_error=ex.ToApiError();}
        catch(OperationCanceledException){}
        finally{_loading=false;StateHasChanged();}
    }
    private void ApplyFilter(){
        var q=_all.AsEnumerable();
        if(!string.IsNullOrWhiteSpace(_search)){ var s=_search.Trim(); q=q.Where(m=> m.Codigo.Contains(s,StringComparison.OrdinalIgnoreCase)||m.Nombre.Contains(s,StringComparison.OrdinalIgnoreCase));}
        _filtered=q.ToList(); _page=1; UpdatePaged();
    }
    private void UpdatePaged(){ _pageCount=Math.Max(1,(int)Math.Ceiling(_filtered.Count/(double)_pageSize)); _page=Math.Clamp(_page,1,_pageCount); _start=(_page-1)*_pageSize; _end=Math.Min(_start+_pageSize,_filtered.Count); _paged=_filtered.Skip(_start).Take(_pageSize).ToList(); }
    private void OnPageChanged(int p){_page=p; UpdatePaged();}
}
