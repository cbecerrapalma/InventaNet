@page "/bodegas"
@attribute [Authorize]
@inject Inventa.Web.Services.Bodegas.BodegasApiService Svc
@inject Inventa.Web.Services.Auth.PermissionService PermsService
@inject Inventa.Web.Services.Tenant.TenantContextService TenantCtx
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@implements IDisposable

<PageHeader Title="Bodegas" Description="Bodegas del tenant actual." Icon="@Icons.Material.Filled.Warehouse">
    <Actions>
        @if (_canAdmin){<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate" aria-label="Nueva bodega">Nueva bodega</MudButton>}
    </Actions>
</PageHeader>

@if (!_checked){<LoadingState />}
else if (!_allowed){<Forbidden />}
else if (_loading){<LoadingState Message="Cargando bodegas..." />}
else if (_error is not null){<ErrorState Title="@_error.Title" Detail="@_error.Detail" CorrelationId="@_error.CorrelationId" OnRetry="Reload" />}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
        <MudGrid Spacing="2">
            <MudItem xs="10" sm="6"><MudTextField @bind-Value="_search" Label="Buscar..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="OnSearchDebounced" Clearable="true" aria-label="Buscar bodegas" /></MudItem>
            <MudItem xs="2" sm="6" Class="d-flex justify-end align-center">
                <MudTooltip Text="Actualizar"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="Actualizar" /></MudTooltip>
                <div class="d-none d-sm-block ml-2"><MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Label="Por página" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:110px"><MudSelectItem Value="20">20</MudSelectItem><MudSelectItem Value="50">50</MudSelectItem><MudSelectItem Value="100">100</MudSelectItem></MudSelect></div>
            </MudItem>
        </MudGrid>
    </MudPaper>
    @if (_items.Count==0)
    {
        <EmptyState Title="Sin bodegas" Description="@(string.IsNullOrWhiteSpace(_search)?"No existen bodegas para este tenant.":"No hay resultados para el filtro.")" Icon="@Icons.Material.Filled.Warehouse">
            <Action>@if(_canAdmin){<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">Crear bodega</MudButton>}</Action>
        </EmptyState>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Mostrando 0 de @FormatoCl.Miles(_totalCount)</MudText>
    }
    else
    {
        <MudTable Items="@_items" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0" Class="mb-2 inv-tabla-compacta inv-tabla-lista" data-testid="tabla-bodegas">
            <HeaderContent><MudTh>Código</MudTh><MudTh>Nombre</MudTh><MudTh Style="width:130px">Acciones</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código"><b>@context.Codigo</b></MudTd>
                <MudTd DataLabel="Nombre" Class="inv-celda-titulo">@context.Nombre</MudTd>
                <MudTd DataLabel="Acciones" Class="inv-celda-acciones"><MudTooltip Text="Ver"><MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/bodegas/{context.IdBodega}")" aria-label="Ver bodega" /></MudTooltip>@if(_canAdmin){<MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(()=>OpenEdit(context))" aria-label="Editar bodega" /></MudTooltip>}</MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="paginacion-texto">Mostrando @FormatoCl.Miles(_pageStart+1)–@FormatoCl.Miles(_pageEnd) de @FormatoCl.Miles(_totalCount)</MudText>
            <MudPagination Count="@_totalPages" Selected="_page" SelectedChanged="OnPageChanged" Color="Color.Primary" BoundaryCount="1" MiddleCount="1" aria-label="Paginación bodegas" />
        </MudStack>
    }
}

@code {
    private bool _checked; private bool _allowed; private bool _canAdmin;
    private bool _loading=true; private Inventa.Web.Models.Api.ApiError? _error;
    private List<Inventa.Web.Models.Bodegas.BodegaDto> _items=[];
    private string _search=""; private int _page=1; private int _pageSize=20; private int _totalCount; private int _totalPages=1; private int _pageStart; private int _pageEnd;
    private CancellationTokenSource? _cts; private int _loadGen;
    protected override async Task OnInitializedAsync(){ _allowed=await PermsService.HasPermissionAsync("INVENTA_BODEGAS_PRINCIPAL_VER"); _canAdmin=await PermsService.HasPermissionAsync("INVENTA_BODEGAS_PRINCIPAL_ADMIN"); _checked=true; if(!_allowed) return; TenantCtx.OnTenantChanged+=OnTenantChanged; await LoadAsync(); }
    private void OnTenantChanged(int? localId, int? passPlatId){ _ = OnTenantChangedAsync(localId); }
    private async Task OnTenantChangedAsync(int? localId){ _cts?.Cancel(); _loadGen++; _items.Clear(); _totalCount=0; _totalPages=1; _page=1; await InvokeAsync(async()=>{ _loading=true; StateHasChanged(); await LoadAsync(); StateHasChanged();}); }
    private async Task LoadAsync(){ _cts?.Cancel(); _cts=new CancellationTokenSource(); var ct=_cts.Token; var gen=++_loadGen; _loading=true; _error=null; StateHasChanged(); try{ var paged=await Svc.ListPagedAsync(_search,_page,_pageSize,ct); if(ct.IsCancellationRequested||gen!=_loadGen) return; if(paged is null){ _items=[]; _totalCount=0; _totalPages=1;} else { _items=paged.Items.ToList(); _totalCount=paged.TotalCount; _totalPages=Math.Max(1,paged.TotalPages);} if(_page> _totalPages){ _page=_totalPages; await LoadAsync(); return;} _pageStart=_totalCount==0?0:(_page-1)*_pageSize; _pageEnd=Math.Min(_pageStart+_items.Count,_totalCount); } catch(Inventa.Web.Models.Api.ApiException ex){ if(gen!=_loadGen) return; _error=ex.ToApiError(); if(ex.StatusCode==401) Snackbar.Add("Sesión expirada", Severity.Warning);} catch(OperationCanceledException){} catch(Exception ex){ if(gen!=_loadGen) return; _error=new(){StatusCode=0, Title="Error", Detail=ex.Message};} finally{ if(gen==_loadGen){ _loading=false; StateHasChanged();}} }
    private async Task Reload(){ _page=1; await LoadAsync(); }
    private async Task OnSearchDebounced(string v){ _search=v??""; _page=1; await LoadAsync(); }
    private async Task OnPageChanged(int p){ _page=p; await LoadAsync(); }
    private async Task OnPageSizeChanged(int s){ _pageSize=s; _page=1; await LoadAsync(); }
    private async Task OpenCreate(){ var dlg=await Dialogs.ShowAsync<Inventa.Web.Shared.Inventory.BodegaFormDialog>("Nueva bodega"); var r=await dlg.Result; if(r is not null && !r.Canceled) await LoadAsync(); }
    private async Task OpenEdit(Inventa.Web.Models.Bodegas.BodegaDto m){ var pars=new DialogParameters{ ["Model"]=m }; var dlg=await Dialogs.ShowAsync<Inventa.Web.Shared.Inventory.BodegaFormDialog>("Editar bodega", pars); var r=await dlg.Result; if(r is not null && !r.Canceled) await LoadAsync(); }
    public void Dispose(){ TenantCtx.OnTenantChanged-=OnTenantChanged; _cts?.Cancel(); _cts?.Dispose(); }
}
