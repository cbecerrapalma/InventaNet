@page "/proveedores"
@attribute [Authorize]
@inject Inventa.Web.Services.Proveedores.ProveedoresApiService Svc
@inject Inventa.Web.Services.Auth.PermissionService PermsService
@inject Inventa.Web.Services.Tenant.TenantContextService TenantCtx
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@implements IDisposable

<PageHeader Title="Proveedores" Description="Proveedores del tenant actual." Icon="@Icons.Material.Filled.LocalShipping">
    <Actions>
        @if (_canEdit)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate" aria-label="Nuevo proveedor">Nuevo proveedor</MudButton>
        }
    </Actions>
</PageHeader>

@if (!_checked) { <LoadingState /> }
else if (!_allowed) { <Forbidden /> }
else if (_loading) { <LoadingState Message="Cargando proveedores..." /> }
else if (_error is not null)
{
    <ErrorState Title="@_error.Title" Detail="@_error.Detail" CorrelationId="@_error.CorrelationId" OnRetry="Reload" />
}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_search" Label="Buscar..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="OnSearchDebounced" Clearable="true" aria-label="Buscar proveedores" /></MudItem>
            <MudItem xs="10" md="3"><MudSelect T="bool?" Value="_filtroActivo" ValueChanged="OnActivoChanged" Label="Estado" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Dense="true"><MudSelectItem Value="@((bool?)null)">Todos</MudSelectItem><MudSelectItem Value="@((bool?)true)">Activo</MudSelectItem><MudSelectItem Value="@((bool?)false)">Inactivo</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="2" md="3" Class="d-flex justify-end align-center">
                <MudTooltip Text="Actualizar"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="Actualizar" /></MudTooltip>
                <div class="d-none d-md-block ml-2"><MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Label="Por página" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:110px"><MudSelectItem Value="20">20</MudSelectItem><MudSelectItem Value="50">50</MudSelectItem><MudSelectItem Value="100">100</MudSelectItem></MudSelect></div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_displayed.Count == 0)
    {
        <EmptyState Title="Sin proveedores" Description="@(string.IsNullOrWhiteSpace(_search) && _filtroActivo is null ? "No existen proveedores para este tenant." : "No hay resultados para el filtro aplicado.")" Icon="@Icons.Material.Filled.LocalShipping">
            <Action>@if(_canEdit){<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreate">Crear proveedor</MudButton>}</Action>
        </EmptyState>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Mostrando 0 de @FormatoCl.Miles(_totalCount)</MudText>
    }
    else
    {
        <MudTable Items="@_displayed" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0" Class="mb-2 inv-tabla-compacta inv-tabla-lista" data-testid="tabla-proveedores">
            <HeaderContent><MudTh>Código</MudTh><MudTh>Razón social</MudTh><MudTh>Estado</MudTh><MudTh Style="width:130px">Acciones</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código"><b>@context.Codigo</b></MudTd>
                <MudTd DataLabel="Razón social" Class="inv-celda-titulo">@context.RazonSocial</MudTd>
                <MudTd DataLabel="Estado"><MudChip T="string" Size="Size.Small" Color="@(context.Activo?Color.Success:Color.Default)">@(context.Activo?"Activo":"Inactivo")</MudChip></MudTd>
                <MudTd DataLabel="Acciones" Class="inv-celda-acciones">
                    @if (_canEdit){<MudTooltip Text="Editar"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(()=>OpenEdit(context))" aria-label="Editar proveedor" /></MudTooltip>}
                    <MudTooltip Text="Ver"><MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/proveedores/{context.IdProveedor}")" aria-label="Ver proveedor" /></MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="paginacion-texto">Mostrando @FormatoCl.Miles(_pageStart+1)–@FormatoCl.Miles(_pageEnd) de @FormatoCl.Miles(_totalCount)</MudText>
            <MudPagination Count="@_totalPages" Selected="_page" SelectedChanged="OnPageChanged" Color="Color.Primary" BoundaryCount="1" MiddleCount="1" aria-label="Paginación proveedores" />
        </MudStack>
    }
}

@code {
    private bool _checked; private bool _allowed; private bool _canEdit;
    private bool _loading = true;
    private Inventa.Web.Models.Api.ApiError? _error;
    private List<Inventa.Web.Models.Proveedores.ProveedorDto> _items = [];
    private List<Inventa.Web.Models.Proveedores.ProveedorDto> _displayed = [];
    private string _search=""; private bool? _filtroActivo;
    private int _page=1; private int _pageSize=20; private int _totalCount; private int _totalPages=1; private int _pageStart; private int _pageEnd;
    private CancellationTokenSource? _cts; private int _loadGen;
    protected override async Task OnInitializedAsync(){ _allowed=await PermsService.HasPermissionAsync("INVENTA_PROVEEDORES_PRINCIPAL_VER"); _canEdit=await PermsService.HasPermissionAsync("INVENTA_PROVEEDORES_PRINCIPAL_EDITAR"); _checked=true; if(!_allowed) return; TenantCtx.OnTenantChanged+=OnTenantChanged; await LoadAsync(); }
    private void OnTenantChanged(int? localId, int? passPlatId){ _ = OnTenantChangedAsync(localId); }
    private async Task OnTenantChangedAsync(int? localId){ _cts?.Cancel(); _loadGen++; _items.Clear(); _displayed.Clear(); _totalCount=0; _totalPages=1; _page=1; await InvokeAsync(async()=>{ _loading=true; StateHasChanged(); await LoadAsync(); StateHasChanged();}); }
    private async Task LoadAsync(){ _cts?.Cancel(); _cts=new CancellationTokenSource(); var ct=_cts.Token; var gen=++_loadGen; _loading=true; _error=null; StateHasChanged(); try{ var paged=await Svc.ListPagedAsync(_search,_filtroActivo,_page,_pageSize,ct); if(ct.IsCancellationRequested||gen!=_loadGen) return; if(paged is null){ _items=[]; _totalCount=0; _totalPages=1;} else { _items=paged.Items.ToList(); _totalCount=paged.TotalCount; _totalPages=Math.Max(1,paged.TotalPages);} if(_page> _totalPages){ _page=_totalPages; await LoadAsync(); return;} ApplyLocal(); } catch(Inventa.Web.Models.Api.ApiException ex){ if(gen!=_loadGen) return; _error=ex.ToApiError(); if(ex.StatusCode==401) Snackbar.Add("Sesión expirada", Severity.Warning);} catch(OperationCanceledException){} catch(Exception ex){ if(gen!=_loadGen) return; _error=new(){StatusCode=0, Title="Error", Detail=ex.Message};} finally{ if(gen==_loadGen){ _loading=false; StateHasChanged();}} }
    private void ApplyLocal(){ _displayed=_items; _pageStart=_totalCount==0?0:(_page-1)*_pageSize; _pageEnd=Math.Min(_pageStart+_items.Count,_totalCount); }
    private async Task Reload(){ _page=1; await LoadAsync(); }
    private async Task OnSearchDebounced(string v){ _search=v??""; _page=1; await LoadAsync(); }
    private async Task OnPageChanged(int p){ _page=p; await LoadAsync(); }
    private async Task OnPageSizeChanged(int s){ _pageSize=s; _page=1; await LoadAsync(); }
    private async Task OnActivoChanged(bool? v){ _filtroActivo=v; _page=1; await LoadAsync(); }
    private async Task OpenCreate(){ var dlg=await Dialogs.ShowAsync<Inventa.Web.Shared.Supplier.ProveedorFormDialog>("Nuevo proveedor"); var r=await dlg.Result; if(r is not null && !r.Canceled) await LoadAsync(); }
    private async Task OpenEdit(Inventa.Web.Models.Proveedores.ProveedorDto m){ var pars=new DialogParameters{ ["Model"]=m }; var dlg=await Dialogs.ShowAsync<Inventa.Web.Shared.Supplier.ProveedorFormDialog>("Editar proveedor", pars); var r=await dlg.Result; if(r is not null && !r.Canceled) await LoadAsync(); }
    public void Dispose(){ TenantCtx.OnTenantChanged-=OnTenantChanged; _cts?.Cancel(); _cts?.Dispose(); }
}
