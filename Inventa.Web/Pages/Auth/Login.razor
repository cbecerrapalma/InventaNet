@page "/login"
@layout AuthLayout
@using System
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Inventa.Web.Models
@using Inventa.Web.Models.Api
@using Inventa.Web.Services.Auth
@using CBP.Blazor.Mud.Login
@inject AuthService AuthService
@inject AppSettings AppConfig
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http

<PageTitle>Ingresar | InventaNet</PageTitle>

<MudPaper Elevation="0" Class="pa-0" data-testid="login-card">
    <EditForm Model="@_model" OnValidSubmit="OnLogin">
        <DataAnnotationsValidator />
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mb-4">
            <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-0" data-testid="login-title">Ingresar</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" data-testid="login-subtitle">Elige el tenant e ingresa con tu usuario y contraseña.</MudText>
        </MudStack>

        <MudTextField Value="@_appNombre" Label="Aplicación" Variant="Variant.Outlined" Class="mb-3" ReadOnly="true" Disabled="@(_appLoading)" data-testid="login-app" aria-label="Aplicación" />
        @if (!string.IsNullOrWhiteSpace(_appError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="login-app-error">@_appError</MudAlert>
        }

        <MudSelect T="int?" Value="_model.IdTenant" ValueChanged="OnTenantChangedAsync" Label="Tenant" Variant="Variant.Outlined" Class="mb-3" For="@(() => _model.IdTenant)" Required="true" RequiredError="Tenant es requerido" Disabled="@(_tenantsLoading)" Placeholder="Selecciona un tenant" data-testid="login-tenant" aria-label="Seleccionar tenant">
            @if (_tenantsLoading)
            {
                <MudSelectItem Value="@((int?)null)" Disabled="true">Cargando tenants...</MudSelectItem>
            }
            else if (_tenants != null && _tenants.Count > 0)
            {
                foreach (var t in _tenants)
                {
                    <MudSelectItem Value="@((int?)t.IdTenant)">@t.Codigo - @t.Nombre</MudSelectItem>
                }
            }
            else
            {
                <MudSelectItem Value="@((int?)null)" Disabled="true">No hay tenants disponibles</MudSelectItem>
            }
        </MudSelect>
        @if (!string.IsNullOrWhiteSpace(_tenantsError))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="login-tenants-error">@_tenantsError</MudAlert>
        }

        <MudTextField @bind-Value="_model.NomUsuario" Label="Usuario o Email" Variant="Variant.Outlined" Class="mb-3" For="@(() => _model.NomUsuario)" data-testid="login-user" aria-label="Usuario o Email" autocomplete="username" AutoFocus="true" Immediate="true" Required="true" RequiredError="Usuario es requerido" />
        <MudTextField @bind-Value="_model.Password" Label="Contraseña" InputType="@(_showPwd ? InputType.Text : InputType.Password)" Variant="Variant.Outlined" Class="mb-3" For="@(() => _model.Password)" data-testid="login-password" aria-label="Contraseña" autocomplete="current-password" Adornment="Adornment.End" AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" AdornmentAriaLabel="@(_showPwd ? "Ocultar contraseña" : "Mostrar contraseña")" OnAdornmentClick="@(() => _showPwd = !_showPwd)" Required="true" RequiredError="Contraseña es requerida" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="@_severity" Class="mb-3" data-testid="login-error">@_error
                @if (!string.IsNullOrWhiteSpace(_correlation)) { <br /><small data-testid="login-error-correlation">Código de seguimiento: @_correlation</small> }
            </MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Disabled="@(_loading || _appUnavailable)" data-testid="login-submit" aria-label="Entrar">
            @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" data-testid="login-loading" /> } Entrar
        </MudButton>
        @if (_proveedores.Count > 0)
        {
            <MudStack Spacing="2" Class="mt-4" data-testid="login-externo">
                <MudDivider />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">o continúa con</MudText>
                @foreach (var prov in _proveedores)
                {
                    var p = prov;
                    @* S128 D3 — botón compartido de CBP.Blazor.Mud (ícono y color desde los datos). *@
                    <BotonProveedorExterno Codigo="@p.Codigo" Nombre="@p.Nombre" Icono="@p.Icono" Color="@p.Color"
                                           Cargando="@(_proveedorIniciando == p.Codigo)" Deshabilitado="@(_loading || _proveedorIniciando != null)"
                                           OnClick="@(() => IniciarExternoAsync(p))" data-testid="@($"login-externo-{p.Codigo.ToLowerInvariant()}")" />
                }
            </MudStack>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mt-3">¿Problemas para ingresar? Contacta al administrador.</MudText>
    </EditForm>
</MudPaper>

@code {
    private LoginModel _model = new();
    private bool _loading;
    private string? _error;
    private string? _correlation;
    private Severity _severity = Severity.Error;
    private bool _showPwd;
    private List<TenantOpt>? _tenants;
    private bool _tenantsLoading = true;
    private string? _tenantsError;
    private string _appNombre = "";
    private bool _appLoading = true;
    private bool _appUnavailable;
    private string? _appError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated ?? false) { Nav.NavigateTo("/", replace: true); return; }
        await Task.WhenAll(LoadTenantsAsync(), LoadAppAsync());
    }

    private async Task LoadAppAsync()
    {
        _appLoading = true;
        try
        {
            var app = await Http.GetFromJsonAsync<AppInfo>($"api/public/apps/{Uri.EscapeDataString(AppConfig.AppCodigo)}");
            if (app is null || !string.Equals(app.Codigo, AppConfig.AppCodigo, StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Respuesta de aplicación no válida.");
            _appNombre = $"{app.Nombre} ({app.Codigo})";
        }
        catch
        {
            _appUnavailable = true;
            _appError = $"La aplicación configurada ({AppConfig.AppCodigo}) no está disponible. Contacta al administrador.";
        }
        finally { _appLoading = false; }
    }

    private async Task LoadTenantsAsync()
    {
        _tenantsLoading = true;
        try
        {
            _tenants = await Http.GetFromJsonAsync<List<TenantOpt>>("api/public/tenants");
            if (_tenants != null && _tenants.Count == 1 && _model.IdTenant == null)
            {
                _model.IdTenant = _tenants[0].IdTenant;
                await CargarProveedoresAsync();
            }
        }
        catch
        {
            _tenantsError = "No se pudo cargar la lista de tenants. Recarga la página.";
        }
        finally { _tenantsLoading = false; }
    }

    private async Task OnLogin()
    {
        if (_model.IdTenant == null || _model.IdTenant == 0) { _error = "Seleccione un tenant."; return; }
        var ppTenant = _tenants?.FirstOrDefault(t => t.IdTenant == _model.IdTenant)?.IdTenantPassPlat;
        if (ppTenant == null || ppTenant == 0) { _error = "Este tenant no está habilitado para ingresar. Contacta al administrador."; return; }
        _loading = true; _error = null; _correlation = null;
        try
        {
            var email = _model.NomUsuario.Contains("@") ? _model.NomUsuario : null;
            var nom = email is null ? _model.NomUsuario : "";
            await AuthService.LoginAsync(nom, email ?? "", _model.Password, ppTenant);
            Snackbar.Add("Sesión iniciada", Severity.Success);
            Nav.NavigateTo("/", replace: true);
        }
        catch (ApiException ex)
        {
            _correlation = ex.CorrelationId;
            _severity = ex.StatusCode switch { 401 => Severity.Warning, 403 => Severity.Error, 503 => Severity.Info, _ => Severity.Error };
            // S96 D2: PWD_EXPIRADA → mensaje específico (llega en cuerpo {codigo,mensaje})
            var isPwdExpirada = ex.StatusCode == 403 && !string.IsNullOrWhiteSpace(ex.Message)
                && ex.Message.Contains("LOGIN_PWD_EXPIRADA", StringComparison.OrdinalIgnoreCase);
            _error = ex.StatusCode switch
            {
                401 => "Credenciales inválidas o sesión no autorizada.",
                403 when isPwdExpirada => "Tu contraseña venció. Restablécela desde PassPlat o pide a un administrador que la cambie.",
                403 => "Tu usuario no tiene acceso a este tenant o aplicación.",
                503 => "Servicio temporalmente no disponible.",
                _ => "Error de autenticación."
            };
        }
        catch (InvalidOperationException ex)
        {
            // S87.2-H1: sesión ya persistida, solo falló la resolución del tenant local.
            _severity = Severity.Warning;
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Error inesperado. Intente nuevamente.";
        }
        finally { _loading = false; }
    }

    // S127 D3 — login externo: proveedores del tenant elegido, vía Inventa.WebAPI → PassPlat.Client.
    private List<ProveedorExterno> _proveedores = [];
    private string? _proveedorIniciando;

    private async Task OnTenantChangedAsync(int? idTenant)
    {
        _model.IdTenant = idTenant;
        await CargarProveedoresAsync();
    }

    private async Task CargarProveedoresAsync()
    {
        _proveedores = [];
        var ppTenant = _tenants?.FirstOrDefault(t => t.IdTenant == _model.IdTenant)?.IdTenantPassPlat;
        if (ppTenant is null or 0) return;
        try
        {
            var lista = await Http.GetFromJsonAsync<List<ProveedorExterno>>($"api/auth/externo/proveedores?appCodigo={Uri.EscapeDataString(AppConfig.AppCodigo)}&idTenantPassPlat={ppTenant}");
            _proveedores = lista?.OrderBy(p => p.OrdenVisual).ToList() ?? [];
        }
        catch
        {
            _proveedores = [];
        }
    }

    private async Task IniciarExternoAsync(ProveedorExterno prov)
    {
        var ppTenant = _tenants?.FirstOrDefault(t => t.IdTenant == _model.IdTenant)?.IdTenantPassPlat;
        if (ppTenant is null or 0) { _error = "Seleccione un tenant."; return; }
        _proveedorIniciando = prov.Codigo; _error = null; _correlation = null;
        try
        {
            var r = await Http.GetFromJsonAsync<AutorizarRespuesta>($"api/auth/externo/{Uri.EscapeDataString(prov.Codigo)}/authorize?appCodigo={Uri.EscapeDataString(AppConfig.AppCodigo)}&idTenantPassPlat={ppTenant}");
            var url = r?.AuthorizationUrl;
            if (!string.IsNullOrWhiteSpace(url))
            {
                Nav.NavigateTo(url, forceLoad: true);
                return;
            }
            _severity = Severity.Error;
            _error = $"No se pudo iniciar sesión con {prov.Nombre}.";
        }
        catch
        {
            _severity = Severity.Error;
            _error = $"No se pudo iniciar sesión con {prov.Nombre}.";
        }
        finally { _proveedorIniciando = null; }
    }

    private sealed record ProveedorExterno(string Codigo, string Nombre, int OrdenVisual, string? Icono = null, string? Color = null);
    private sealed record AutorizarRespuesta(string? AuthorizationUrl);

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Usuario es requerido")] public string NomUsuario { get; set; } = "";
        [Required(ErrorMessage = "Contraseña es requerida")] public string Password { get; set; } = "";
        [Required(ErrorMessage = "Tenant es requerido")] public int? IdTenant { get; set; }
    }
    private sealed record TenantOpt(int IdTenant, string Codigo, string Nombre, int? IdTenantPassPlat = null);
    private sealed record AppInfo(string Codigo, string Nombre);
}