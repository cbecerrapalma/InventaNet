{
  // S57.38: ConnectionStrings:InventaDb es la UNICA fuente de conexion (appsettings).
  // Requisitos historicos de env para BBDD (INVENTA_TARGET/SQL password) obsoletos.
  // S57.38: fuente canonica unica de conexion Inventa (sin env SQL, sin fallback).
  "ConnectionStrings": {
    "InventaDb": "Server=.;Database=Inventa;TrustServerCertificate=True;Trusted_Connection=True;"
  },
  "PassPlat": {
    "ApiBaseUrl": "https://localhost:5001",
    "TimeoutMs": 10000
  },
  "Jwt": {
    "Issuer": "PassPlat",
    "Audience": "InventaNet",
    "SecretKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PublicCatalog": {
    "PassPlatTenantId": 3
  },
  "StoreAuth": {
    "AppCodigo": "INVENTA_STORE"
  },
  "Cors": {
    "StorePublicAllowedOrigins": []
  },
  // S104: storage de archivos (CBP.Storage). Provider = Local | S3. Las credenciales de S3 (Storage:S3) las
  // escribe el dueño en appsettings.Development.json; aquí no va ningún secreto. Ver Docs/Architecture/Storage.md.
  "Storage": {
    "Provider": "Local",
    "Local": {
      "Containers": {
        // S107: fuera del repo (decisión del dueño 2026-11-11). public se publica en /uploads (UseCbpStorageLocalPublicFiles).
        "public": {
          "Root": "D:/InventaStorage/public",
          "PublicBasePath": "uploads"
        },
        "private": {
          "Root": "D:/InventaStorage/private"
        }
      }
    },
    // S107 (P10): hosts desde los que el servidor importa imágenes por URL (RemoteUploadService). Vacío = ninguno.
    // ficcus.vteximg.com.br: imágenes de prueba del catálogo Ficcus (uso local; publicarlas exige permiso del comercio).
    "Remote": {
      "AllowedHosts": [ "ficcus.vteximg.com.br" ],
      "Timeout": "00:00:20"
    }
  }
}
